{
  "permissions": {
    "allow": [
      "Bash(python3 tools/run_workflow.py *)",
      "Bash(python3 tools/validate_pipeline_semantics.py *)",
      "Bash(python3 tools/validate_workspace_root.py *)",
      "Bash(python3 tools/audit_orchestration.py *)",
      "Bash(mkdir -p workspace/tmp/*)",
      "Bash(cat workspace/tmp/*)",
      "Bash(jq -er * workspace/tmp/*)",
      "Bash(date -u *)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(echo \"---exit:$?---\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'ROOT=$(git rev-parse --show-toplevel) || exit 2; PYTHONPATH=\"$ROOT${PYTHONPATH:+:$PYTHONPATH}\" python3 -m tools.hooks.dev_cli --backend claude --event PreToolUse'"
          }
        ]
      }
    ]
  }
}
